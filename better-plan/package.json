{
  "name": "better-plan",
  "version": "0.10.8",
  "private": true,
  "description": "Two-phase grilling-then-planning agent with a right-sidebar confirmation panel.",
  "license": "MIT",
  "author": "WQLEON",
  "type": "module",
  "icon": "icon.svg",
  "engines": {
    "node": "^22.19.0 || >=24.0.0",
    "dsh": ">=0.2.2-rc.5"
  },
  "scripts": {
    "test": "node --test"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-ui-sidebar-right",
        "@deepseek-ai/dsh-client-locale"
      ]
    }
  },
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "client.js",
    "disciplines.js",
    "lib/core.js",
    "cordis.patch.yml",
    "locale/*.json",
    "docs",
    "icon.svg",
    "README.md",
    "README_en.md",
    "node_modules"
  ],
  "dependencies": {
    "@deepseek-ai/schemastery": "3.20.0-alpha.1"
  }
}
